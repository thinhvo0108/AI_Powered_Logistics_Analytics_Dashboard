# =============================================================
# AI-Powered Logistics Analytics Dashboard — Environment Config
# =============================================================
# Copy this file to .env and fill in values before running.
# NEVER commit .env to the repository.

# ─── LLM Provider ───────────────────────────────────────────
# Choose one: ollama | runpod | openai
LLM_PROVIDER=ollama

# ─── Ollama (local, default) ────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest

# ─── RunPod (cloud GPU — OpenAI-compatible endpoint) ────────
# Sign up at runpod.io, deploy a vLLM serverless endpoint,
# then paste the API key and endpoint ID here.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Model name as served by vLLM on your RunPod pod:
RUNPOD_MODEL=meta-llama/Llama-3.2-3B-Instruct

# ─── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── API Security ───────────────────────────────────────────
# Comma-separated key:role pairs (admin | viewer)
API_KEYS=dev-secret-key:admin,reviewer-key:viewer
CORS_ORIGINS=http://localhost:3000

# ─── Data ───────────────────────────────────────────────────
# Path to the logistics CSV (relative to backend/)
DATA_PATH=data/mock_logistics_data.csv

# ─── Cache (bonus) ──────────────────────────────────────────
QUERY_CACHE_TTL_SECONDS=300
